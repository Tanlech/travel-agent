APP_NAME=travel-agent
APP_ENV=dev
DEBUG=false

AMAP_KEY=your_amap_key_here
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
AMAP_TIMEOUT_SECONDS=10.0

# 和风天气（天气数据源，替代高德天气）：预报与城市搜索为两个独立 key，不通用
QWEATHER_API_KEY=your_qweather_weather_api_key_here
QWEATHER_GEO_API_KEY=your_qweather_geo_api_key_here
QWEATHER_HOST=your_project.re.qweatherapi.com
# 订阅支持的最大预报天数（weather 按行程日期自动选择 3/7/10/15/30d 端点，不超过此上限）
QWEATHER_FORECAST_DAYS=30
QWEATHER_TIMEOUT_SECONDS=10.0

REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=604800

# MySQL（用户账号体系）：与 docker-compose 的 mysql 服务保持一致
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=travel
MYSQL_PASSWORD=travel
MYSQL_DATABASE=travel_agent

# 用户账号体系：登录令牌有效期 + 首次启动自动创建的管理员账号
AUTH_TOKEN_TTL_SECONDS=604800
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=your_admin_password

LLM_PROVIDER=qwen
OPENAI_API_KEY=your_qwen_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=60
ENABLE_MOCK_LLM=false

# attraction_tool：把搜索确认的主要景点写回城市 json，并单点同步到 Qdrant（后台异步）
ATTRACTION_PERSIST_ENABLED=true
